# =============================================
# Smart Home Automation - Environment Variables
# =============================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Render deployment, set these in the
# Render Dashboard -> Environment Variables
# =============================================

# === DATABASE CONNECTION ===
# Option A (Recommended for Render): Use Render's Internal PostgreSQL
# Render auto-injects DATABASE_URL. Just enable SSL:
SQL_SSL=true

# Option B: Manual PostgreSQL connection (local dev or external DB)
# SQL_HOST=localhost
# SQL_PORT=5432
# SQL_DB_NAME=smart-home-automation
# SQL_USER=postgres
# SQL_PASSWORD=your-db-password

# === JWT AUTHENTICATION ===
# Secret key used to sign and verify JWT tokens
# Generate a strong random string (e.g., openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-secret-string

# === AUTHORIZATION PASSCODE ===
# Passcode new users must enter to unlock full system control
# This prevents unauthorized access to critical operations
AUTH_PASSCODE=IOTSAFE2026

# === SERVER PORT (Optional) ===
# Render automatically sets PORT. For local dev, defaults to 3000.
# PORT=3000

