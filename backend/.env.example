# --- PostgreSQL connection (used at runtime by the app) ---
SQL_HOST=localhost
SQL_USER=postgres
SQL_PASSWORD=12345
SQL_DB_NAME=smart-home-automation

# --- PostgreSQL admin credentials (used only by drizzle-kit for migrations) ---
SQL_ADMIN_USER=postgres
SQL_ADMIN_PASSWORD=12345

# --- Auth ---
# Secret used to sign/verify login JWTs. Set this to a long random string in production.
JWT_SECRET=6mX#9Qv!P2rL@7zKf8Nc$4TwH1yJ&sA5Bg3UdE0WpRxM!9Cv

# Passcode required for a newly registered (non-first, non-admin) account to be authorized
# to control the system. Defaults to "IOTSAFE2026" if not set.
AUTH_PASSCODE=IOTSAFE2026
